# Copier en .env (jamais commité).

# PostgreSQL (docker-compose)
POSTGRES_USER=runningstats
POSTGRES_PASSWORD=runningstats
POSTGRES_DB=runningstats
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://runningstats:runningstats@localhost:5433/runningstats
# true en production (HTTPS)
SESSION_COOKIE_SECURE=false

# Clé maître qui chiffre les clés et jetons Garmin en base (Fernet). À générer une fois :
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# La perdre rend illisibles les clés Garmin enregistrées (les membres devront les ressaisir).
GARMIN_ENCRYPTION_KEY=

# Dossier des FIT bruts (par défaut : data/ à la racine du dépôt, ignoré par git)
# DATA_DIR=/chemin/vers/data
